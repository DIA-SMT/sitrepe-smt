# Copiá este archivo como .env.local y completá los valores de tu proyecto Supabase
# (Supabase → Project Settings → API / Database).

# URL del proyecto, p. ej. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (publishable "sb_publishable_..." o la anon key legacy)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (secret "sb_secret_..." o la service_role key legacy).
# Solo se usa del lado del servidor y en los scripts. Nunca la expongas en el navegador.
SUPABASE_SECRET_KEY=

# Cadena de conexión a Postgres (Project Settings → Database → Connection string → URI,
# modo "Session pooler"). Se usa para aplicar las migraciones con `npm run db:push`.
SUPABASE_DB_URL=

# URL pública de la app (se usa en los códigos QR de los certificados)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: sal para el hash de origen del límite de envíos de los formularios públicos
# (denuncias e inscripciones). Si se omite, se deriva de SUPABASE_SECRET_KEY.
LIMITE_ENVIO_SAL=

# Solo para `npm run usuarios:demo`: contraseña de las cuentas de demostración (no se versiona).
USUARIOS_DEMO_CLAVE=
